# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Email (SMTP for production — Brevo recommended: https://brevo.com, free 300/day)
# Get credentials from Brevo dashboard -> Settings -> SMTP & API -> SMTP Keys.
# Server: smtp-relay.brevo.com | Port: 587 | TLS on.
# DEFAULT_FROM_EMAIL must be a sender verified under Settings -> Sender Identity.
DEFAULT_FROM_EMAIL=Student PMS <noreply@example.com>
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-key

# Production only
# DATABASE_URL=postgres://user:pass@localhost:5432/student_pms
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# On Render these are injected automatically (see render.yaml): DATABASE_URL,
# DJANGO_SETTINGS_MODULE=config.settings.prod, DEBUG=false, SECRET_KEY, ALLOWED_HOSTS.
# SMTP keys above are the only ones you must add for live verification emails.
