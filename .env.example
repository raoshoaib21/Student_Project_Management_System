# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Email (SMTP for production)
DEFAULT_FROM_EMAIL=Student PMS <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Production only
# DATABASE_URL=postgres://user:pass@localhost:5432/student_pms
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# On Render these are injected automatically (see render.yaml): DATABASE_URL,
# DJANGO_SETTINGS_MODULE=config.settings.prod, DEBUG=false, SECRET_KEY, ALLOWED_HOSTS.
# SMTP keys above are the only ones you must add for live verification emails.
